{
  "schemaVersion": "0.1.0",
  "name": "X (Twitter) Post",
  "behavior": "create",
  "path": "00 Inbox",
  "context": "",
  "triggers": [
    "/^https:\\/\\/x\\.com\\/[A-Za-z0-9_]+\\/status\\/\\d+/",
    "/^https:\\/\\/twitter\\.com\\/[A-Za-z0-9_]+\\/status\\/\\d+/"
  ],
  "noteNameFormat": "{{published|date:\"YYYY-MM-DD\"}} -- X -- {{url|split:\"/\"|slice:3,-2|first|safe_name:linux|slice:0,60}}",
  "noteContentFormat": "![tweet]({{url}})\n\n---\n\n{{selectorHtml:div[data-testid=\"tweetText\"]|first|markdown|trim}}\n\n---\n\n## Notlar\n\n",
  "properties": [
    {"name": "type", "value": "referans", "type": "text"},
    {"name": "date", "value": "{{published|date:\"YYYY-MM-DD\"}}", "type": "date"},
    {"name": "created", "value": "{{date|date:\"YYYY-MM-DD\"}}", "type": "date"},
    {"name": "tags", "value": "kaynak, kaynak/x", "type": "multitext"},
    {"name": "source", "value": "{{url}}", "type": "text"},
    {"name": "source_type", "value": "x", "type": "text"},
    {"name": "title", "value": "{{selector:div[data-testid=\"tweetText\"]|first|remove_html|trim|slice:0,100}}", "type": "text"},
    {"name": "author", "value": "{{url|split:\"/\"|slice:3,-2|first}}", "type": "multitext"},
    {"name": "handle", "value": "@{{url|split:\"/\"|slice:3,-2|first}}", "type": "text"}
  ]
}
