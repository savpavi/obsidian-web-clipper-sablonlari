{
  "schemaVersion": "0.1.0",
  "name": "Varsayılan",
  "behavior": "create",
  "path": "00 Inbox",
  "context": "",
  "triggers": [],
  "noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}} -- Klip -- {% set clipValue = title %}{% if not clipValue %}{% set clipValue = \"Başlıksız\" %}{% endif %}{{clipValue|safe_name:linux|slice:0,60}}",
  "noteContentFormat": "{{content}}\n\n---\n\n## Notlar\n\n",
  "properties": [
    {
      "name": "type",
      "value": "referans",
      "type": "text"
    },
    {
      "name": "date",
      "value": "{{date|date:\"YYYY-MM-DD\"}}",
      "type": "date"
    },
    {
      "name": "created",
      "value": "{{date|date:\"YYYY-MM-DD\"}}",
      "type": "date"
    },
    {
      "name": "tags",
      "value": "kaynak",
      "type": "multitext"
    },
    {
      "name": "source",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "source_type",
      "value": "klip",
      "type": "text"
    },
    {
      "name": "title",
      "value": "{% set clipValue = title %}{% if not clipValue %}{% set clipValue = \"Başlıksız\" %}{% endif %}{{clipValue}}",
      "type": "text"
    },
    {
      "name": "author",
      "value": "{{author}}",
      "type": "multitext"
    },
    {
      "name": "site",
      "value": "{{site}}",
      "type": "text"
    },
    {
      "name": "description",
      "value": "{{description|slice:0,300}}",
      "type": "text"
    }
  ]
}
